{"condition": "9_engine_v2_full", "prompt_id": "t_cd_04", "category": "code_and_sql", "instruction": "Write a Python function called fibonacci(n) that returns the n-th Fibonacci number.", "response": "def fibonacci(n):\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        return fibonacci(n-1) + fibonacci(n-2)\n\nprint(fibonacci(10))", "raw_text": " def fibonacci(n):\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        return fibonacci(n-1) + fibonacci(n-2)\n\nprint(fibonacci(10))", "n_new_tokens": 52, "stop_reason": "eos", "stop_string": null, "prompt_tokens": 20, "latency_s": 2.066022624960169, "ms_per_token": 39.7312043261571, "stop_events": [{"t": 11, "score": -0.0109}, {"t": 16, "score": 0.1115}, {"t": 23, "score": -0.0134}, {"t": 28, "score": 0.1728}, {"t": 31, "score": 0.1091}, {"t": 44, "score": 0.4335}], "engine_trace": {}, "extra_prompt_tokens": 0, "metrics": {"turn_cross": 1.0, "constraint": 1.0, "clean_stop": 1.0, "fluency": 1.0, "composite": 1.0, "natural_eos": 1.0, "constraint_detail": {"0:python_def": true, "1:code_keywords": true}, "contamination": [], "distinct4": 1.0}, "engine_config": {"lifecycle": true, "dynamic_stop": true, "erase": true, "predictor": true, "pin_attention": true, "static_caa": false, "alpha_init": 1.0, "gamma": 0.4, "init_steps": 4, "alpha_sustain": 0.35, "split_budget": true, "alpha_stop": 1.0, "stop_min_step": 8, "stop_logit_boost": 5.0, "newturn_logprob": -1.5, "lambda_erase": 0.35, "erase_kappa": 1.0, "erase_mode": "hinge", "lambda_hinge": 0.75, "hinge_kappa_floor": 2.6, "predictor_weight": 1.0, "predictor_clip": 1.0, "beta_attn": 0.5, "signed_attention": true, "beta_neg_attn": 0.5, "neg_span_mode": "clause", "unembed_project": true, "gamma_unembed": 2.0, "unembed_center": true, "alpha_caa": 2.0}}
{"condition": "9_engine_v2_full", "prompt_id": "t_cd_05", "category": "code_and_sql", "instruction": "Write a JavaScript function called sumArray that returns the sum of an array of numbers.", "response": "function sumArray(arr) {\n  let sum = 0;\n  for (let i = 0; i < arr.length; i++) {\n    sum += arr[i];\n  }\n  return sum;\n}", "raw_text": " function sumArray(arr) {\n  let sum = 0;\n  for (let i = 0; i < arr.length; i++) {\n    sum += arr[i];\n  }\n  return sum;\n}\n\nQuestion:", "n_new_tokens": 45, "stop_reason": "stop_string", "stop_string": "\nQuestion:", "prompt_tokens": 21, "latency_s": 1.7636632079957053, "ms_per_token": 39.1925157332379, "stop_events": [{"t": 13, "score": 0.0766}, {"t": 30, "score": 0.0465}, {"t": 36, "score": 0.2322}, {"t": 38, "score": 0.2144}, {"t": 42, "score": 0.4269}, {"t": 43, "score": 0.4473}, {"t": 43, "reason": "newturn"}], "engine_trace": {}, "extra_prompt_tokens": 0, "metrics": {"turn_cross": 1.0, "constraint": 1.0, "clean_stop": 1.0, "fluency": 1.0, "composite": 1.0, "natural_eos": 0.0, "constraint_detail": {"0:code_keywords": true}, "contamination": [], "distinct4": 1.0}, "engine_config": {"lifecycle": true, "dynamic_stop": true, "erase": true, "predictor": true, "pin_attention": true, "static_caa": false, "alpha_init": 1.0, "gamma": 0.4, "init_steps": 4, "alpha_sustain": 0.35, "split_budget": true, "alpha_stop": 1.0, "stop_min_step": 8, "stop_logit_boost": 5.0, "newturn_logprob": -1.5, "lambda_erase": 0.35, "erase_kappa": 1.0, "erase_mode": "hinge", "lambda_hinge": 0.75, "hinge_kappa_floor": 2.6, "predictor_weight": 1.0, "predictor_clip": 1.0, "beta_attn": 0.5, "signed_attention": true, "beta_neg_attn": 0.5, "neg_span_mode": "clause", "unembed_project": true, "gamma_unembed": 2.0, "unembed_center": true, "alpha_caa": 2.0}}
