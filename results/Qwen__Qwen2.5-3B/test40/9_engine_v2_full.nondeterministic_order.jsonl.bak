{"condition": "9_engine_v2_full", "prompt_id": "t_qa_02", "category": "direct_qa", "instruction": "How do quantum computers differ from classical computers?", "response": "Quantum computers use quantum bits, or qubits, which can exist in multiple states at once, allowing them to perform many calculations simultaneously. Classical computers, on the other hand, use classical bits, which can only exist in one state at a time.", "raw_text": " Quantum computers use quantum bits, or qubits, which can exist in multiple states at once, allowing them to perform many calculations simultaneously. Classical computers, on the other hand, use classical bits, which can only exist in one state at a time.\n\nQuestion:", "n_new_tokens": 52, "stop_reason": "stop_string", "stop_string": "\nQuestion:", "prompt_tokens": 13, "latency_s": 2.012087665963918, "ms_per_token": 38.69399357622919, "stop_events": [{"t": 27, "score": 0.5646}, {"t": 50, "score": 0.3903}, {"t": 50, "reason": "newturn"}], "engine_trace": {}, "extra_prompt_tokens": 0, "metrics": {"turn_cross": 1.0, "constraint": 1.0, "clean_stop": 1.0, "fluency": 1.0, "composite": 1.0, "natural_eos": 0.0, "constraint_detail": {"0:keywords_min": true}, "contamination": [], "distinct4": 1.0}, "engine_config": {"lifecycle": true, "dynamic_stop": true, "erase": true, "predictor": true, "pin_attention": true, "static_caa": false, "alpha_init": 1.0, "gamma": 0.4, "init_steps": 4, "alpha_sustain": 0.35, "split_budget": true, "alpha_stop": 1.0, "stop_min_step": 8, "stop_logit_boost": 5.0, "newturn_logprob": -1.5, "lambda_erase": 0.35, "erase_kappa": 1.0, "erase_mode": "hinge", "lambda_hinge": 0.75, "hinge_kappa_floor": 2.6, "predictor_weight": 1.0, "predictor_clip": 1.0, "beta_attn": 0.5, "signed_attention": true, "beta_neg_attn": 0.5, "neg_span_mode": "clause", "unembed_project": true, "gamma_unembed": 2.0, "unembed_center": true, "alpha_caa": 2.0}}
{"condition": "9_engine_v2_full", "prompt_id": "t_qa_03", "category": "direct_qa", "instruction": "Why is the sky blue?", "response": "The sky is blue because of the scattering of sunlight by the Earth's atmosphere. The blue light has a shorter wavelength than other colors of light, and it is scattered more easily by the molecules in the atmosphere. This scattering causes the blue light to be scattered in all directions, including towards our eyes, which is why the sky appears blue.", "raw_text": " The sky is blue because of the scattering of sunlight by the Earth's atmosphere. The blue light has a shorter wavelength than other colors of light, and it is scattered more easily by the molecules in the atmosphere. This scattering causes the blue light to be scattered in all directions, including towards our eyes, which is why the sky appears blue.", "n_new_tokens": 68, "stop_reason": "eos", "stop_string": null, "prompt_tokens": 10, "latency_s": 2.656797999981791, "ms_per_token": 39.07055882326163, "stop_events": [{"t": 16, "score": 0.5223}, {"t": 42, "score": 0.5713}, {"t": 68, "score": 0.6744}, {"t": 68, "reason": "centroid"}], "engine_trace": {}, "extra_prompt_tokens": 0, "metrics": {"turn_cross": 1.0, "constraint": 1.0, "clean_stop": 1.0, "fluency": 1.0, "composite": 1.0, "natural_eos": 1.0, "constraint_detail": {"0:keywords_min": true}, "contamination": [], "distinct4": 1.0}, "engine_config": {"lifecycle": true, "dynamic_stop": true, "erase": true, "predictor": true, "pin_attention": true, "static_caa": false, "alpha_init": 1.0, "gamma": 0.4, "init_steps": 4, "alpha_sustain": 0.35, "split_budget": true, "alpha_stop": 1.0, "stop_min_step": 8, "stop_logit_boost": 5.0, "newturn_logprob": -1.5, "lambda_erase": 0.35, "erase_kappa": 1.0, "erase_mode": "hinge", "lambda_hinge": 0.75, "hinge_kappa_floor": 2.6, "predictor_weight": 1.0, "predictor_clip": 1.0, "beta_attn": 0.5, "signed_attention": true, "beta_neg_attn": 0.5, "neg_span_mode": "clause", "unembed_project": true, 