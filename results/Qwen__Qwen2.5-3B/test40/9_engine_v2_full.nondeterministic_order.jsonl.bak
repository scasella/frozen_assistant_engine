{"condition": "9_engine_v2_full", "prompt_id": "t_cd_02", "category": "code_and_sql", "instruction": "Write a Python function called is_prime(n) that returns True if n is a prime number and False otherwise.", "response": "def is_prime(n):\n    if n <= 1:\n        return False\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True", "raw_text": " def is_prime(n):\n    if n <= 1:\n        return False\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True", "n_new_tokens": 51, "stop_reason": "eos", "stop_string": null, "prompt_tokens": 26, "latency_s": 2.0170460829976946, "ms_per_token": 39.54992319603323, "stop_events": [{"t": 12, "score": 0.0405}, {"t": 16, "score": 0.1413}, {"t": 29, "score": -0.0257}, {"t": 35, "score": 0.079}, {"t": 44, "score": 0.0513}, {"t": 48, "score": 0.2291}], "engine_trace": {}, "extra_prompt_tokens": 0, "metrics": {"turn_cross": 1.0, "constraint": 1.0, "clean_stop": 1.0, "fluency": 1.0, "composite": 1.0, "natural_eos": 1.0, "constraint_detail": {"0:python_def": true, "1:code_keywords": true}, "contamination": [], "distinct4": 1.0}, "engine_config": {"lifecycle": true, "dynamic_stop": true, "erase": true, "predictor": true, "pin_attention": true, "static_caa": false, "alpha_init": 1.0, "gamma": 0.4, "init_steps": 4, "alpha_sustain": 0.35, "split_budget": true, "alpha_stop": 1.0, "stop_min_step": 8, "stop_logit_boost": 5.0, "newturn_logprob": -1.5, "lambda_erase": 0.35, "erase_kappa": 1.0, "erase_mode": "hinge", "lambda_hinge": 0.75, "hinge_kappa_floor": 2.6, "predictor_weight": 1.0, "predictor_clip": 1.0, "beta_attn": 0.5, "signed_attention": true, "beta_neg_attn": 0.5, "neg_span_mode": "clause", "unembed_project": true, "gamma_unembed": 2.0, "unembed_center": true, "alpha_caa": 2.0}}
